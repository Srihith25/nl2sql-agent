# --- LLM ---
# Choose one: "groq" (free), "anthropic" (paid), "mock" (offline tests)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Data ---
DB_PATH=./data/warehouse.duckdb
VECTOR_DB_PATH=./data/vectors.duckdb

# --- Embedder ---
# auto / sentence-transformers / hash
EMBEDDER=auto
EMBED_MODEL=all-MiniLM-L6-v2

# --- Agent ---
MAX_HEAL_ATTEMPTS=3
TOP_K_TABLES=5
TOP_K_COLUMNS=15
TOP_K_EXAMPLES=3

# --- Optional: Cube semantic layer (leave blank to disable) ---
CUBE_URL=
CUBE_API_SECRET=

# --- Optional: Langfuse observability (leave blank to disable) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
